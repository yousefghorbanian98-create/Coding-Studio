{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-studio.dev/schemas/factory/requirements.schema.json",
  "title": "Coding Studio Backend Factory requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements"],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "title",
        "description",
        "kind",
        "milestone",
        "stage",
        "status",
        "securitySensitive",
        "acceptanceCriteria",
        "nonGoals",
        "dependencies",
        "threats",
        "implementationFiles",
        "plannedUnitTests",
        "plannedIntegrationTests",
        "plannedWindowsTests",
        "n8nResearch",
        "tasteDecision",
        "ossProvenance",
        "evidencePaths",
        "implementationCommit",
        "ciRun"
      ],
      "properties": {
        "identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "milestone": { "type": "integer", "minimum": 0, "maximum": 8 },
        "stage": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["factory", "implementation", "future"] },
        "status": { "enum": ["planned", "in-progress", "complete", "blocked"] },
        "securitySensitive": { "type": "boolean" },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nonGoals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "threats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "implementationFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "plannedUnitTests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "plannedIntegrationTests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "plannedWindowsTests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "n8nResearch": { "type": "string", "minLength": 1 },
        "tasteDecision": { "type": "string" },
        "ossProvenance": { "type": "string", "minLength": 1 },
        "evidencePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "implementationCommit": { "type": ["string", "null"] },
        "ciRun": { "type": ["string", "null"] }
      }
    }
  }
}
