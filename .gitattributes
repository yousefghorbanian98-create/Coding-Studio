# Keep the frozen mission documents and machine files byte-stable on Windows so
# the SHA-256 manifest hashes match the committed bytes regardless of
# core.autocrlf. This is Stage Zero factory infrastructure; it does not unpin
# or weaken any existing action or security control.
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Milestone One: protocol/release fixture bytes are contractual (byte-exact
# SHA-256 hashing and NDJSON semantics). Keep them LF-stable on Windows
# checkouts regardless of core.autocrlf.
src-tauri/tests/fixtures/jcode/** text eol=lf

# Exception: the synthetic TUI byte sample is binary test input; never convert
# its line endings (control bytes are the point of the fixture).
src-tauri/tests/fixtures/jcode/protocol/*.bin -text
